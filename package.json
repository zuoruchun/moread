{
  "name": "moread",
  "version": "1.0.1",
  "description": "墨读 MoRead - 个人自用 macOS Markdown 阅读器 (Swift/AppKit + WKWebView)",
  "author": "Ruchun Zuo",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc && vite build",
    "build": "./build-native.sh",
    "test": "vitest run",
    "test:native": "swiftc -O -target arm64-apple-macos14.0 src-native/SettingsManager.swift src-native/FileWatcher.swift tests/native/TestNativeSuite.swift -o /tmp/run_native_tests && /tmp/run_native_tests"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "mathjax-full": "^3.2.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.16.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
